<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_create_issue_wizard" model="ir.ui.view">
        <field name="name">task.issue.wizard.form</field>
        <field name="model">task.issue.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Issue">
                <group>
                    <field name="title"/>
                    <field name="description"/>
                    <field name="task_id" invisible="1"/>
                </group>
                <footer>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                    <button name="action_create_issue" string="Submit"
                            type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for opening the wizard -->
    <record id="action_create_issue_wizard" model="ir.actions.act_window">
        <field name="name">Create Github Issue</field>
        <field name="res_model">task.issue.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
